.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw source data is large (OSM .pbf ~220MB, RENIPRESS/SIGMED exports) and
# is re-downloaded by src/acquisition.py — not committed by default.
# Exception: if a source portal is unreachable, the specific cached file
# used that day is force-added and documented in the data quality report.
data/raw/*
!data/raw/.gitkeep

# Exception: district population (2017 census) is NOT re-downloadable — it
# was extracted once from INEI's PDF-only publication by
# scripts/extract_population_by_district.py (needs pdfplumber/pypdf, not
# part of the main pipeline's requirements.txt). Committed so Phase 3's
# population weighting works without re-running that extraction.
!data/raw/poblacion_distrital_*.csv
# Intermediate PDF/JSON cache from that one-time extraction — reproducible
# by re-running the script, not needed once the CSVs above exist.
data/raw/_population_extraction_cache/
data/raw/censo2017_*.pdf

# OSMnx / routing graph cache (rebuildable from data/raw via src/routing.py)
data/cache/

logs/*.log

# Streamlit
.streamlit/secrets.toml

# LaTeX build artifacts (keep the committed main.pdf, ignore intermediates)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/*.synctex.gz

# Harness/session artifacts
.claude/scheduled_tasks.lock

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
